root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# All four values below are already ktlint_official defaults. They are set explicitly
# because IntelliJ's own formatter (Ctrl+Alt+L) does not know the ktlint defaults and
# would otherwise format code that ktlintCheck then rejects.
ktlint_code_style = ktlint_official
max_line_length = 140
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Never collapse imports into wildcards. IntelliJ defaults to '*' after 5 classes (or 3
# members) from the same package, which conflicts with ktlint's no-wildcard-imports rule.
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
# Clears IntelliJ's built-in on-demand list (java.util.*, kotlinx.android.synthetic.**) and
# allowlists the enum entry wildcards this project depends on. The mapping tables
# (YtelseToRegistreringshjemlerV2 and friends) reference up to ~1100 distinct entries from a
# single enum, where explicit imports would be noise rather than documentation. ktlint's
# no-wildcard-imports rule reads the same property, so the allowlist covers both tools.
ij_kotlin_packages_to_use_import_on_demand = no.nav.klage.kodeverk.Enhet.**,no.nav.klage.kodeverk.SattPaaVentReason.**,no.nav.klage.kodeverk.Utfall.**,no.nav.klage.kodeverk.hjemmel.Hjemmel.**,no.nav.klage.kodeverk.hjemmel.Registreringshjemmel.**

[*.{yaml,yml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
